# Browser mode does not use local VAD or PortAudio.
# CLI analyze/coach modes do.
VOICE_COACH_VAD_PROVIDER=energy
VOICE_COACH_ENERGY_THRESHOLD=0.04

# Only needed when VOICE_COACH_VAD_PROVIDER=silero
SILERO_MODEL_PATH=C:\models\silero_vad.onnx
VOICE_COACH_PYTHON_EXE=python
VOICE_COACH_SILERO_THRESHOLD=0.5

# Browser mode and coach mode
VOICE_COACH_STT_PROVIDER=python-mistral
VOICE_COACH_STT_PYTHON_EXE=python
MISTRAL_API_KEY=
MISTRAL_BASE_URL=https://api.mistral.ai
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=

# Optional websocket override for the legacy Go STT client
VOXTRAL_REALTIME_URL=

# Optional overrides
VOXTRAL_MODEL=voxtral-mini-transcribe-realtime-2602
VOXTRAL_TARGET_STREAMING_DELAY_MS=0
MISTRAL_LLM_MODEL=mistral-small-latest
CARTESIA_VERSION=2025-04-16
CARTESIA_MODEL_ID=sonic-3
CARTESIA_LANGUAGE=en

# Optional console status output for coach mode
VOICE_COACH_CONSOLE=false
